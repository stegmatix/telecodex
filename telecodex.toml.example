# Local runtime config. Copy to telecodex.toml and keep it out of git.
# Configure startup_admin_ids and the Telegram token source for your machine.
# If your host has a broken sandbox runtime, you can temporarily use:
# default_sandbox = "danger-full-access"

db_path = "telecodex.sqlite3"
startup_admin_ids = [123456789]
poll_timeout_seconds = 30
edit_debounce_ms = 900
max_text_chunk = 3500
tmp_dir = "/absolute/path/to/telecodex/tmp"

[telegram]
bot_token_env = "TELECODEX_TELEGRAM_BOT_TOKEN"
api_base = "https://api.telegram.org"
use_message_drafts = true
primary_forum_chat_id = -1001234567890
auto_create_topics = false
forum_sync_topics_per_poll = 2
stale_topic_days = 30
stale_topic_action = "close"

[codex]
binary = "codex"
default_cwd = "/absolute/path/to/telecodex"
default_model = "gpt-6-astra"
default_reasoning_effort = "xhigh"
default_sandbox = "workspace-write"
default_approval = "never"
default_search_mode = "disabled"
import_desktop_history = true
import_cli_history = true
seed_workspaces = ["/absolute/path/to/workspace-a"]
default_add_dirs = [
  "/absolute/path/to/workspace"
]

# Optional agent backends, selected globally with /agent codex|claude|antigravity.
[claude]
binary = "claude"
# default_model = "opus"
models = ["opus", "sonnet", "haiku"]
# permission_mode = "bypassPermissions"  # default: derived from the session sandbox
# extra_args = []

[antigravity]
binary = "agy"
# default_model = "gemini-4-neon-high"
# permission_mode = "skip-permissions"  # default: derived from the session sandbox
# extra_args = []
